ENV=development
PORT=3000
DATABASE_URL=postgres://postgres@localhost:5432/accounting
# used by `bun test`; every table is truncated between tests
DATABASE_TEST_URL=postgres://postgres@localhost:5432/accounting_test
JWT_SECRET=change-me
RPC_URL=https://eth.merkle.io
# optional: instance config (sign-in methods, SSO). Defaults to ./firebook.config.json
# FIREBOOK_CONFIG=/etc/firebook/firebook.config.json
# optional: OIDC client secret, so it can stay out of the config file
# OIDC_CLIENT_SECRET=
